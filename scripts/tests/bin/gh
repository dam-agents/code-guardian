#!/usr/bin/env bash
# Fake `gh` for scripts/tests — serves canned fixtures, never talks to GitHub.
# Maps the invocation to a fixture file: $GH_FIXTURES/<slug>, where <slug> is
# the full argument string with every character outside [A-Za-z0-9._-]
# replaced by `_` (see fx_for in helpers.sh — keep the two in sync).
# Unmatched calls return a safe default: `[]` for list-shaped endpoints
# (anything with a query string), `{}` otherwise.
args="$*"
slug="$(printf '%s' "$args" | tr -c 'A-Za-z0-9._-' '_')"
# GraphQL calls get a stable slug keyed by the PR number: the query text is
# multi-line and changes whenever the query is edited, which would silently
# orphan every fixture named after it.
case "$args" in
  (*graphql*PruneStates*)
    slug="graphql_prune_states";;
  (*graphql*pullRequest*lastEditedAt*)
    slug="graphql_pr_lastedited_$(printf '%s' "$args" | tr ' ' '\n' \
            | grep -E '^n=[0-9]+$' | head -1 | cut -d= -f2)";;
  (*graphql*pullRequest*reviews*)
    slug="graphql_pr_reviews_$(printf '%s' "$args" | tr ' ' '\n' \
            | grep -E '^n=[0-9]+$' | head -1 | cut -d= -f2)";;
esac
[ -n "${GH_CALLS_LOG:-}" ] && printf '%s\n' "$args" >> "$GH_CALLS_LOG"
# <slug>.rc simulates a failing call (fx_fail / fx_fail_once in helpers.sh):
# exit with the stored code; a `once:<code>` value fails this call only. A
# <slug>.err file is the error body real gh prints to stderr on a non-2xx
# answer (fx_err in helpers.sh) — callers that read the API's error text see it.
if [ -n "${GH_FIXTURES:-}" ] && [ -f "$GH_FIXTURES/$slug.rc" ]; then
  rc="$(cat "$GH_FIXTURES/$slug.rc")"
  case "$rc" in (once:*) rm -f "$GH_FIXTURES/$slug.rc"; rc="${rc#once:}";; esac
  [ -f "$GH_FIXTURES/$slug.err" ] && cat "$GH_FIXTURES/$slug.err" >&2
  exit "$rc"
fi
if [ -n "${GH_FIXTURES:-}" ] && [ -f "$GH_FIXTURES/$slug" ]; then
  cat "$GH_FIXTURES/$slug"
  exit 0
fi
# The batched prune-state query with no fixture of its own answers from the
# per-PR REST fixtures, in the GraphQL shape: one alias per PR, null where the
# REST call would fail or has no fixture — as GitHub answers a PR it cannot
# resolve. Cases written for the per-PR call keep exercising the batch.
case "$args" in
  (*graphql*PruneStates*)
    o="$(printf '%s\n' "$@" | sed -n 's/^o=//p' | head -1)"
    r="$(printf '%s\n' "$@" | sed -n 's/^r=//p' | head -1)"
    for n in $(printf '%s' "$args" | grep -oE 'pullRequest\(number:[0-9]+\)' | grep -oE '[0-9]+'); do
      f="$GH_FIXTURES/$(printf '%s' "api repos/$o/$r/pulls/$n" | tr -c 'A-Za-z0-9._-' '_')"
      if [ -f "$f" ] && [ ! -f "$f.rc" ]; then
        jq -c --arg k "p$n" '{($k): (if .state == null then null else
            {state: (if .merged then "MERGED" else (.state | ascii_upcase) end),
             headRefOid: .head.sha, headRefName: .head.ref, title, author: .user} end)}' "$f"
      else
        jq -nc --arg k "p$n" '{($k): null}'
      fi
    done | jq -s '{data: {repository: (add // {})}}'
    exit 0;;
esac
case "$args" in
  *'?'*) echo '[]';;
  *)     echo '{}';;
esac
exit 0
